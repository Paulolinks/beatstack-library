generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String?
  role            String   @default("user")
  approved        Boolean  @default(false)
  managerLicensed Boolean  @default(false)
  licensePurchasedAt DateTime?
  licenseActivatedAt DateTime?
  activeSessionId        String?
  activeManagerSessionId String?
  lastLoginAt            DateTime?
  lastLoginDevice        String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([approved])
  @@index([managerLicensed])
  @@index([role])
  @@index([activeSessionId])
  @@index([activeManagerSessionId])
  @@map("users")
}

model Pack {
  id                String   @id @default(cuid())
  name              String
  producer          String?
  slug              String   @unique
  coverPath         String?
  description       String?
  sourceArchivePath String?
  sampleCount       Int      @default(0)
  presetCount       Int      @default(0)
  genre             String?
  tags              String   @default("[]")
  published         Boolean  @default(true)
  importedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  samples    Sample[]
  assets     PackAsset[]
  importJobs ImportJob[]

  @@map("packs")
}

model Sample {
  id            String   @id @default(cuid())
  packId        String
  fileName      String
  displayName   String
  storagePath   String
  relativePath  String
  durationMs    Int?
  type          String?
  instrument    String?
  category      String?
  genre         String?
  bpm           Int?
  key           String?
  tags          String   @default("[]")
  waveformPeaks String?
  searchText    String?
  createdAt     DateTime @default(now())

  pack            Pack                 @relation(fields: [packId], references: [id], onDelete: Cascade)
  meta            UserSampleMeta?
  collectionItems CollectionSample[]
  favoriteEntries SampleFavoriteFolder[]

  @@index([packId])
  @@index([type])
  @@index([instrument])
  @@index([bpm])
  @@map("samples")
}

model PackAsset {
  id           String   @id @default(cuid())
  packId       String
  name         String
  relativePath String
  storagePath  String
  assetType    String   @default("preset-folder")
  presetKind   String?
  fileCount    Int      @default(0)
  tags         String   @default("[]")
  searchText   String?
  createdAt    DateTime @default(now())

  pack Pack            @relation(fields: [packId], references: [id], onDelete: Cascade)
  meta UserAssetMeta?

  @@index([packId])
  @@index([presetKind])
  @@map("pack_assets")
}

model UserAssetMeta {
  id           String    @id @default(cuid())
  assetId      String    @unique
  downloadedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  asset PackAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("user_asset_meta")
}

model UserSampleMeta {
  id           String    @id @default(cuid())
  sampleId     String    @unique
  rating       Int?
  favorite     Boolean   @default(false)
  downloadedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sample Sample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  @@index([favorite])
  @@index([rating])
  @@map("user_sample_meta")
}

model Collection {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  samples CollectionSample[]

  @@map("collections")
}

model CollectionSample {
  id           String   @id @default(cuid())
  collectionId String
  sampleId     String
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sample     Sample     @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  @@unique([collectionId, sampleId])
  @@map("collection_samples")
}

model ImportJob {
  id           String   @id @default(cuid())
  packId       String?
  fileName     String
  inboxPath    String
  status       String   @default("PENDING")
  progress     Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pack Pack? @relation(fields: [packId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("import_jobs")
}

model FavoriteFolder {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  samples SampleFavoriteFolder[]

  @@map("favorite_folders")
}

model SampleFavoriteFolder {
  id       String   @id @default(cuid())
  sampleId String
  folderId String
  addedAt  DateTime @default(now())

  sample Sample         @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  folder FavoriteFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([sampleId, folderId])
  @@index([folderId])
  @@map("sample_favorite_folders")
}

model ManagerSetting {
  id                     String  @id @default("singleton")
  activeFavoriteFolderId String?
  preferredLocale        String  @default("en")

  @@map("manager_settings")
}

model Campaign {
  id                   String    @id @default(cuid())
  title                String
  titleEn              String?
  body                 String
  bodyEn               String?
  type                 String    @default("notice")
  options              String    @default("[]")
  allowText            Boolean   @default(false)
  autoSubmitOnOption   Boolean   @default(true)
  active               Boolean   @default(true)
  startsAt             DateTime?
  endsAt               DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  responses CampaignResponse[]

  @@index([active])
  @@map("campaigns")
}

model CampaignResponse {
  id             String    @id @default(cuid())
  campaignId     String
  userEmail      String
  openedAt       DateTime?
  respondedAt    DateTime?
  selectedOption String?
  textResponse   String?
  createdAt      DateTime  @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userEmail])
  @@index([userEmail])
  @@map("campaign_responses")
}

model LegalAcceptance {
  id             String   @id @default(cuid())
  userId         String?
  email          String?
  termsVersion   String
  privacyVersion String
  appVersion     String?
  os             String?
  ipAddress      String?
  source         String   @default("app")
  acceptedAt     DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([acceptedAt])
  @@map("legal_acceptances")
}
